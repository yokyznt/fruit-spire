{
  "name": "fruit-spire",
  "version": "2.9.0",
  "private": true,
  "description": "Fruit Spire — roguelike de cartas",
  "scripts": {
    "test": "node tests/run-all.js",
    "www": "node scripts/build-www.js",
    "android:init": "npm install @capacitor/core @capacitor/cli @capacitor/android && npx cap add android",
    "android:sync": "node scripts/build-www.js && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npm run android:sync && node scripts/build-apk.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  }
}
